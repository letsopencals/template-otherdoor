# Opencals storefront API: a private storefront key (spk_) from Dashboard → Account → API Keys.
# This site calls the API from its server only.
# OPENCALS_API_URL is optional (defaults to https://api.opencals.com)
OPENCALS_API_URL=https://api.opencals.com
OPENCALS_API_KEY=spk_your_private_storefront_key

# next-auth (customer sessions). Generate with: npx auth secret
AUTH_SECRET=change-me
